@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		task ("Given the Blogs Portlet is added to the page") {
			TestCase.setUpPortalInstance();

			User.firstLoginPG();

			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");

			JSONLayout.addWidgetToPublicLayout(
				column = 1,
				groupName = "Guest",
				layoutName = "Blogs Page",
				widgetName = "Blogs");

			Navigator.gotoPage(pageName = "Blogs Page");
		}
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();
		}
	}

	@description = "Can Edit a Blog"
	@priority = 5
	test CanEditBlog {
		task ("AND a Blog Entry exists") {
			JSONBlog.addEntry(
				entryContent = "Blog Henrique Content",
				entryTitle = "Blog Henrique Title");

			Navigator.gotoPage(pageName = "Blogs Page");

			BlogsEntry.viewEntryPG(
				entryContent = "Blog Henrique Content",
				entryTitle = "Blog Henrique Title");
		}

		task ("When the User edits the blog Entry") {
			Blogs.editEntryPG(
				entryContent = "Blog Henrique Content",
				entryContentEdit = "Edited Blog Henrique Content",
				entryTitle = "Blog Henrique Title",
				entryTitleEdit = "Edited Blog Henrique Title");
		}

		task ("Then the Blog Entry should be edited") {
			BlogsEntry.viewEntryPG(
				entryContent = "Edited Blog Henrique Content",
				entryTitle = "Edited Blog Henrique Title");
		}
	}

}