definition {

	macro CloseSimulationMenu {
		Click(locator1 = "MyTestFile#CLOSE_BUTTON");
	}

	macro OpenSimulationMenu {
		Click(locator1 = "MyTestFile#SIMULATION_BUTTON");
	}

	macro SetCustomScreenSize {
		Click(locator1 = "MyTestFile#CUSTOM_OPTION");

		Type.sendKeys(
			locator1 = "MyTestFile#HEIGHT_FIELD",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			locator1 = "MyTestFile#HEIGHT_FIELD",
			value1 = ${customHeight});

		Type.sendKeys(
			locator1 = "MyTestFile#WIDTH_FIELD",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			locator1 = "MyTestFile#WIDTH_FIELD",
			value1 = ${customWidth});

		Click(locator1 = "MyTestFile#APPLY_CUSTOM_SIZE");
	}

	macro ValidateScreenSizeValue {
		AssertElementPresent(
			key_customSizeValue = ${customSizeValue},
			locator1 = "MyTestFile#SCREEN_SIZE_VALUE");
	}

}